{
  "name": "@vyra/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json && node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "worker": "node --env-file-if-exists=.env dist/src/worker.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPatterns=unit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/src/seed/seed.js",
    "prisma:reset": "prisma migrate reset --force",
    "openapi": "tsx scripts/export-openapi.ts",
    "photos:generate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/src/seed/generate-photos.js"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env dist/src/seed/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.917.0",
    "@nestjs/common": "^11.1.7",
    "@nestjs/core": "^11.1.7",
    "@nestjs/platform-express": "^11.1.7",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.0",
    "@sentry/node": "^10.78.0",
    "@vyra/shared": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.61.2",
    "bwip-js": "^4.7.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nanoid": "^3.3.11",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.7",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.12",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "@vyra/config": "workspace:*",
    "jest": "^30.2.0",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
