// VYRA database schema. PostgreSQL 16 + pgvector.
// Conventions: cuid ids, snake_case tables via @@map, money as Decimal(12,2) rupees,
// timestamps in UTC (timestamptz), soft delete via deletedAt where history matters.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

// ---------------------------------------------------------------- enums

enum RoleName {
  SUPER_ADMIN
  ADMIN
  INVENTORY_MANAGER
  ORDER_MANAGER
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Gender {
  MEN
  WOMEN
  KIDS
  UNISEX
}

enum BarcodeSymbology {
  EAN13
  CODE128
  QR
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
  FULFILLMENT
  RETURN_RESTOCK
}

enum ScanMode {
  IDENTIFY
  RECEIVE
  ADJUST
  DISPATCH
  RETURN
}

enum ScanDevice {
  CAMERA
  USB
  BLUETOOTH
  MANUAL
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
}

enum ShippingProviderName {
  MANUAL
  SHIPROCKET
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum EmbeddingKind {
  TEXT
  IMAGE
}

enum EmbeddingJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ---------------------------------------------------------------- identity & access

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "inventory:write"
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?   @unique
  name            String
  passwordHash    String
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  isActive        Boolean   @default(true)
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  lastLoginAt     DateTime? @db.Timestamptz(3)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)

  customerProfile CustomerProfile?
  addresses       Address[]
  sessions        Session[]
  tokens          UserToken[]
  cart            Cart?
  wishlist        Wishlist?
  orders          Order[]
  reviews         Review[]
  couponUsages    CouponUsage[]
  returnRequests  ReturnRequest[]
  searchHistory   SearchHistory[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  movements       InventoryMovement[]
  scans           ScanEvent[]

  @@index([roleId])
  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  audience         String // "customer" | "staff"
  userAgent        String?
  ip               String?
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  replacedById     String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model UserToken {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime     @db.Timestamptz(3)
  usedAt    DateTime?    @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose])
  @@map("user_tokens")
}

model CustomerProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth          DateTime? @db.Date
  gender               Gender?
  marketingOptIn       Boolean   @default(false)
  notes                String? // internal support notes
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  @@map("customer_profiles")
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String      @db.Char(6)
  type      AddressType @default(HOME)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?   @db.Timestamptz(3)

  @@index([userId])
  @@map("addresses")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------------- catalog

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  code           String     @db.Char(3) // used in SKUs
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  description    String?
  imageUrl       String?
  bannerUrl      String?
  seoTitle       String?
  seoDescription String?
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?  @db.Timestamptz(3)
  products       Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String        @id @default(cuid())
  /// Monotonic human sequence used inside SKUs (VY-TSH-00042-…)
  seq            Int           @unique @default(autoincrement())
  name           String
  slug           String        @unique
  description    String
  brand          String        @default("VYRA")
  gender         Gender
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  status         ProductStatus @default(DRAFT)
  tags           String[]      @default([])
  sizeChart      Json?
  hsnCode        String        @default("6109")
  isFeatured     Boolean       @default(false)
  seoTitle       String?
  seoDescription String?
  // Denormalised read-model fields maintained by the catalog service (listing speed).
  minPrice       Decimal       @default(0) @db.Decimal(12, 2)
  minMrp         Decimal       @default(0) @db.Decimal(12, 2)
  maxDiscount    Int           @default(0)
  ratingAvg      Decimal?      @db.Decimal(3, 2)
  ratingCount    Int           @default(0)
  soldCount      Int           @default(0)
  /// Hash of the text used for the current text embedding (skip re-embedding when unchanged).
  textHash       String?
  publishedAt    DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?     @db.Timestamptz(3)

  variants      ProductVariant[]
  images        ProductImage[]
  videos        ProductVideo[]
  attributes    ProductAttribute[]
  reviews       Review[]
  embeddings    ProductEmbedding[]
  embeddingJobs EmbeddingJob[]
  wishlistItems WishlistItem[]

  @@index([status, categoryId])
  @@index([status, gender])
  @@index([status, minPrice])
  @@index([createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm")
  @@map("products")
}

/// Typed key/value attributes (fabric, fit, occasion…) — filterable.
model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String

  @@unique([productId, key])
  @@index([key, value])
  @@map("product_attributes")
}

/// The sellable unit. Stock, price, SKU and barcode live HERE, never on Product.
model ProductVariant {
  id                String    @id @default(cuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku               String    @unique
  color             String
  colorHex          String?   @db.Char(7)
  size              String
  sizeOrder         Int       @default(0)
  mrp               Decimal   @db.Decimal(12, 2)
  price             Decimal   @db.Decimal(12, 2)
  costPrice         Decimal?  @db.Decimal(12, 2)
  weightGrams       Int       @default(300)
  lowStockThreshold Int       @default(5)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  inventory          Inventory?
  barcodes           Barcode[]
  movements          InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  scans              ScanEvent[]

  @@unique([productId, color, size])
  @@index([productId])
  @@map("product_variants")
}

model Barcode {
  id         String           @id @default(cuid())
  variantId  String
  variant    ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  symbology  BarcodeSymbology
  value      String           @unique
  isPrimary  Boolean          @default(false)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([variantId, symbology])
  @@map("barcodes")
}

/// Monotonic counter for internal EAN-13 issuance (row id = prefix).
model BarcodeSequence {
  prefix String @id
  next   Int    @default(1)

  @@map("barcode_sequences")
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey String
  url        String
  thumbUrl   String
  alt        String   @default("")
  color      String?
  sortOrder  Int      @default(0)
  width      Int?
  height     Int?
  mimeType   String
  bytes      Int
  /// sha256 of original bytes; embedding regenerated when it changes
  contentHash String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  embeddings ProductEmbedding[]

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVideo {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey String
  url        String
  posterUrl  String?
  mimeType   String
  bytes      Int
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@map("product_videos")
}

// ---------------------------------------------------------------- inventory

/// One row per variant. available = onHand - reserved (never stored, never negative).
model Inventory {
  variantId String         @id
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand    Int            @default(0)
  reserved  Int            @default(0)
  version   Int            @default(0)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  @@map("inventory")
}

/// Append-only stock ledger. Every change to Inventory writes exactly one row here
/// in the same transaction. Never update or delete rows.
model InventoryMovement {
  id            String                @id @default(cuid())
  variantId     String
  variant       ProductVariant        @relation(fields: [variantId], references: [id])
  type          InventoryMovementType
  /// Signed change to onHand (STOCK_IN +, STOCK_OUT −, FULFILLMENT −, RETURN_RESTOCK +)
  onHandDelta   Int
  /// Signed change to reserved (RESERVATION +, RELEASE −, FULFILLMENT −)
  reservedDelta Int
  onHandAfter   Int
  reservedAfter Int
  reason        String?
  reference     String?
  orderId       String?
  supplierId    String?
  supplier      Supplier?             @relation(fields: [supplierId], references: [id])
  unitCost      Decimal?              @db.Decimal(12, 2)
  scanId        String?
  actorId       String?
  actor         User?                 @relation(fields: [actorId], references: [id])
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)

  @@index([variantId, createdAt])
  @@index([type, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

model ScanEvent {
  id        String          @id @default(cuid())
  code      String
  mode      ScanMode
  device    ScanDevice
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  orderId   String?
  found     Boolean
  actorId   String
  actor     User            @relation(fields: [actorId], references: [id])
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([orderId, variantId])
  @@map("scan_events")
}

model Supplier {
  id             String              @id @default(cuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  gstin          String?
  address        String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  purchaseOrders PurchaseOrder[]
  movements      InventoryMovement[]

  @@map("suppliers")
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  number     String              @unique
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     PurchaseOrderStatus @default(ORDERED)
  reference  String?
  notes      String?
  totalCost  Decimal             @default(0) @db.Decimal(12, 2)
  createdById String?
  orderedAt  DateTime            @default(now()) @db.Timestamptz(3)
  receivedAt DateTime?           @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)
  items      PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String         @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  quantity         Int
  receivedQuantity Int            @default(0)
  unitCost         Decimal        @db.Decimal(12, 2)

  @@map("purchase_order_items")
}

// ---------------------------------------------------------------- shopping

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Opaque token for guest carts (cookie vyra_cart)
  guestToken String?    @unique
  couponCode String?
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id             String         @id @default(cuid())
  cartId         String
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity       Int
  savedForLater  Boolean        @default(false)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  items     WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------- orders & payments

model Order {
  id              String         @id @default(cuid())
  number          String         @unique
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String
  status          OrderStatus    @default(PENDING_PAYMENT)
  paymentMethod   PaymentMethod
  shippingMethod  ShippingMethod @default(STANDARD)
  /// Snapshot of the delivery address at order time (immutable history).
  shippingAddress Json
  mrpTotal        Decimal        @db.Decimal(12, 2)
  subtotal        Decimal        @db.Decimal(12, 2)
  couponCode      String?
  couponDiscount  Decimal        @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal        @default(0) @db.Decimal(12, 2)
  codFee          Decimal        @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal        @db.Decimal(12, 2)
  idempotencyKey  String         @unique
  reservationExpiresAt DateTime? @db.Timestamptz(3)
  cancelReason    String?
  placedAt        DateTime       @default(now()) @db.Timestamptz(3)
  confirmedAt     DateTime?      @db.Timestamptz(3)
  deliveredAt     DateTime?      @db.Timestamptz(3)
  cancelledAt     DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  items          OrderItem[]
  events         OrderEvent[]
  payments       Payment[]
  refunds        Refund[]
  shipment       Shipment?
  returnRequests ReturnRequest[]
  couponUsage    CouponUsage?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([reservationExpiresAt])
  @@map("orders")
}

/// Immutable snapshot of what was bought, at the price paid.
model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  productId        String
  productName      String
  productSlug      String
  sku              String
  color            String
  size             String
  imageUrl         String?
  hsnCode          String
  quantity         Int
  unitMrp          Decimal        @db.Decimal(12, 2)
  unitPrice        Decimal        @db.Decimal(12, 2)
  discount         Decimal        @default(0) @db.Decimal(12, 2)
  taxRate          Decimal        @db.Decimal(5, 2)
  taxAmount        Decimal        @db.Decimal(12, 2)
  lineTotal        Decimal        @db.Decimal(12, 2)
  returnedQuantity Int            @default(0)

  returnItems ReturnItem[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  actorName String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String // razorpay | mock | cod
  method            PaymentMethod
  status            PaymentStatus @default(CREATED)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  /// Provider-reported instrument (upi, card, netbanking, wallet) — never card numbers.
  instrument        String?
  failureReason     String?
  raw               Json?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  refunds           Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId        String?
  payment          Payment?     @relation(fields: [paymentId], references: [id])
  returnRequestId  String?
  returnRequest    ReturnRequest? @relation(fields: [returnRequestId], references: [id])
  amount           Decimal      @db.Decimal(12, 2)
  status           RefundStatus @default(PENDING)
  reason           String?
  providerRefundId String?      @unique
  createdById      String?
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  @@index([orderId])
  @@map("refunds")
}

/// Webhook deduplication (provider event ids are processed at most once).
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model Shipment {
  id             String               @id @default(cuid())
  orderId        String               @unique
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       ShippingProviderName
  status         ShipmentStatus       @default(PENDING)
  providerShipmentId String?
  courierName    String?
  trackingNumber String?              @unique
  trackingUrl    String?
  labelUrl       String?
  weightGrams    Int?
  shippedAt      DateTime?            @db.Timestamptz(3)
  deliveredAt    DateTime?            @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  events         ShipmentEvent[]

  @@map("shipments")
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  location    String?
  description String?
  occurredAt  DateTime @db.Timestamptz(3)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  status       ReturnStatus @default(REQUESTED)
  reason       String
  comments     String?
  refundAmount Decimal      @default(0) @db.Decimal(12, 2)
  decisionNote String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  items        ReturnItem[]
  refunds      Refund[]

  @@index([orderId])
  @@index([status])
  @@map("return_requests")
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int

  @@map("return_items")
}

// ---------------------------------------------------------------- promotions & reviews

model Coupon {
  id            String        @id @default(cuid())
  code          String        @unique
  description   String?
  type          CouponType
  /// Percentage (0-90) for PERCENTAGE, rupees for FIXED
  value         Decimal       @db.Decimal(12, 2)
  maxDiscount   Decimal?      @db.Decimal(12, 2)
  minOrderValue Decimal?      @db.Decimal(12, 2)
  startsAt      DateTime?     @db.Timestamptz(3)
  expiresAt     DateTime?     @db.Timestamptz(3)
  usageLimit    Int?
  usedCount     Int           @default(0)
  perUserLimit  Int           @default(1)
  categoryIds   String[]      @default([])
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?     @db.Timestamptz(3)
  usages        CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discount  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([couponId, email])
  @@map("coupon_usages")
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  title            String?
  body             String?
  verifiedPurchase Boolean  @default(false)
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@map("reviews")
}

// ---------------------------------------------------------------- AI search

/// One vector per (product, kind, image, model). The model string is part of the
/// key: vectors from different models are NEVER compared (queries filter by model).
model ProductEmbedding {
  id          String                       @id @default(cuid())
  productId   String
  product     Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageId     String?
  image       ProductImage?                @relation(fields: [imageId], references: [id], onDelete: Cascade)
  kind        EmbeddingKind
  model       String
  dimensions  Int
  contentHash String
  vector      Unsupported("vector(768)")
  createdAt   DateTime                     @default(now()) @db.Timestamptz(3)

  @@unique([productId, kind, imageId, model])
  @@index([model, kind])
  @@map("product_embeddings")
}

model EmbeddingJob {
  id          String             @id @default(cuid())
  productId   String
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  status      EmbeddingJobStatus @default(PENDING)
  model       String
  attempts    Int                @default(0)
  lastError   String?
  startedAt   DateTime?          @db.Timestamptz(3)
  completedAt DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  @@index([productId, createdAt])
  @@index([status])
  @@map("embedding_jobs")
}

model SearchHistory {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionKey  String?
  query       String?
  mode        String // keyword | semantic | visual | hybrid
  filters     Json?
  resultCount Int
  latencyMs   Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@map("search_history")
}

// ---------------------------------------------------------------- platform

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String // email | sms | in_app
  template  String
  recipient String
  subject   String?
  payload   Json
  status    String    @default("queued") // queued | sent | failed | skipped
  error     String?
  sentAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String // e.g. product.update, inventory.adjust
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
