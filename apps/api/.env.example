# ---- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vyra:vyra@localhost:5432/vyra?schema=public
REDIS_URL=redis://localhost:6379
# Run BullMQ workers inside the API (dev). In production set false and run `pnpm --filter @vyra/api worker`.
RUN_WORKERS_IN_API=true
# 32+ random chars: `openssl rand -hex 32`. Never commit a real value.
JWT_ACCESS_SECRET=
COOKIE_SECURE=false
# COOKIE_DOMAIN=.vyra.in
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ---- Media -----------------------------------------------------------------
STORAGE_DRIVER=local            # local | s3 (AWS S3, Cloudflare R2, MinIO)
STORAGE_LOCAL_DIR=./storage
MEDIA_BASE_URL=/media           # with s3: your CDN/bucket public URL
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=                  # only for R2/MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Barcodes --------------------------------------------------------------
# "20" = GS1 restricted-circulation (internal use only). Replace with your GS1 India company prefix if you sell on marketplaces.
BARCODE_EAN_PREFIX=20

# ---- Payments (Razorpay) ---------------------------------------------------
PAYMENT_PROVIDER=mock           # razorpay | mock (dev only, refused in production) | none
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
COD_ENABLED=true
PAYMENT_RESERVATION_MINUTES=30

# ---- Shipping (Shiprocket) -------------------------------------------------
SHIPPING_PROVIDER=manual        # manual | shiprocket
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_PICKUP_LOCATION=Primary
# SHIPROCKET_PICKUP_PINCODE=

# ---- AI embeddings ---------------------------------------------------------
EMBEDDING_PROVIDER=local        # gemini (recommended) | local (offline lexical fallback)
# GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
IMAGE_GEN_MODEL=gemini-3.1-flash-image   # AI product photography + virtual try-on
TRYON_DAILY_LIMIT=200                    # global daily cap (~$0.04 each)
TRYON_PER_SESSION_DAILY=5

# ---- Email (SMTP) ----------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=VYRA <no-reply@vyra.local>

# ---- SMS OTP (MSG91) & WhatsApp (Meta Cloud API) -----------------------------
SMS_PROVIDER=console            # msg91 in production (console = log only, OTPs echoed to the client in dev)
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=        # DLT-approved template containing ##OTP##
WHATSAPP_PROVIDER=none          # meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en       # approve templates: vyra_order_confirmed, vyra_cod_confirm, vyra_order_shipped, vyra_order_delivered, vyra_cart_reminder
# OTP_PEPPER=                   # required in production: openssl rand -hex 32

# ---- COD protection & prepaid incentive -----------------------------------
COD_RTO_BLOCK_THRESHOLD=2       # refused COD parcels before COD is disabled for that phone
COD_CONFIRM_WINDOW_HOURS=24     # unconfirmed COD orders auto-cancel after this
PREPAID_DISCOUNT_PERCENT=5      # 0 disables
PREPAID_DISCOUNT_MAX=100        # rupees
ABANDONED_CART_AFTER_HOURS=3

# ---- Monitoring --------------------------------------------------------------
# SENTRY_DSN=

# ---- Invoice / seller details ----------------------------------------------
SELLER_NAME=VYRA Fashion
# SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_STATE=Karnataka
