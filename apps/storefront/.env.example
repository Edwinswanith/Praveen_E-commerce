# Server-side base URL of the VYRA API (used by server components and the /api/v1 + /media rewrites)
API_URL=http://localhost:4000
# Public origin of this storefront (canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: extra https image hostnames (comma-separated) allowed for next/image optimisation, e.g. a CDN
NEXT_PUBLIC_IMAGE_HOSTS=
