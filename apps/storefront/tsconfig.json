  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", "next.config.ts", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": ["node_modules", ".next"]
}
