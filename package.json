{
  "name": "vyra-fashion-commerce",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d postgres redis",
    "db:migrate": "pnpm --filter @vyra/api prisma:migrate",
    "db:seed": "pnpm --filter @vyra/api prisma:seed",
    "db:reset": "pnpm --filter @vyra/api prisma:reset"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3"
  }
}
